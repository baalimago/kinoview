# SeaweedFS S3 credentials for the slivingdoc notebook.
#
# Copy this file to .env and change the values. The docker-compose stack reads
# them to build SeaweedFS's IAM config, and kinoview reads the same pair from
# its own environment (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY). LAN checkout
# clients use the same pair too. The values here are placeholders — replace
# them before any real use.
AWS_ACCESS_KEY_ID=placeholder-access-key
AWS_SECRET_ACCESS_KEY=placeholder-secret-key
